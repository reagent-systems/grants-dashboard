# ─── Database (Neon / Vercel Postgres) ───────────────────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── Vault master key ────────────────────────────────────────────────
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# This key decrypts credentials ONLY inside serverless functions at
# execution time. The agent (LLM) never has shell access to Vercel env,
# so it can never read this. Rotate by re-encrypting the vault.
VAULT_MASTER_KEY=""

# ─── Agent capability token ──────────────────────────────────────────
# The ONLY secret the agent holds. Scoped to intent-submission + status
# reads. Revoke by rotating this value (agent is locked out instantly).
# Generate with:  openssl rand -hex 32
AGENT_TOKEN=""

# ─── Dashboard operator (you) login ──────────────────────────────────
# Protects the vault-write UI and the Tier-2 approval toggles.
OPERATOR_PASSWORD_HASH=""   # scrypt hash, see scripts/hash-password

# ─── Hard safety rails (server-enforced, agent cannot change) ─────────
MAX_JOB_USD="15"            # per-job spend cap for Tier-1 auto actions
MONTHLY_BUDGET_USD="2000"   # total budget ceiling

# ─── Granted AI Playwright worker (grant.* handlers) ─────────────────
# The worker runs OUTSIDE Vercel (Playwright needs a real browser). See
# worker/README.md. The broker calls it with the shared token below.
GRANTED_WORKER_URL=""       # e.g. https://your-worker-box:8790  (internal)
GRANTED_WORKER_TOKEN=""     # shared secret; must match worker's WORKER_TOKEN
